pipeline {
    agent {
        label "builder"
    }

    stages {
        stage('Build and Test') {
            steps { 
                sh"""
                mvn clean package
                """
                echo 'Building..'
            }
        }
        stage('Test') {
            steps {
                echo 'Testing..'
            }
        }
        stage('Deploy') {
            steps {
                sshagent(credentials: [ 'deploy-server-credentials']) {
    sh '''
        scp -o- StrictHostkeyChecking=no ./target/web*.war ec2-user@172.31.42.171:/opt/tomcat/webapps/Root.war
                echo 'Deploying....'
            }
        }
    }
}